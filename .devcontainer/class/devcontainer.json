{
    "name": "PSTAT 234 class",
    
    "dockerFile": "Containerfile",
    //"image": "ghcr.io/ucsb-pstat-234/fall2025:class-v0.0.2-alpha",
    

    "overrideCommand": false,
    "shutdownAction": "none",
    
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind", 
    "workspaceFolder": "/home/jovyan/work",

    "containerEnv": {
        "RETICULATE_PYTHON": "/opt/conda/bin/python"
    },

    "forwardPorts": [8888],
    "portsAttributes": {
        "8888": {
            "label": "Jupyterlab",
            "onAutoForward": "ignore"
        }
    },
	
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python"
            },
            "extensions": [
                "ms-python.python",             // for Python
                "ms-toolsai.jupyter",           // for Python
                "quarto.quarto",                // for Python and R
                "analytic-signal.preview-pdf",
                "GitHub.copilot"
            ]
        }
    }
}
